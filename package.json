{
  "name": "student-handbook",
  "version": "0.0.23",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "start:prod": "next start -p ${PORT:-65200}",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop student-handbook",
    "pm2:restart": "pm2 restart student-handbook",
    "pm2:reload": "pm2 reload student-handbook",
    "pm2:logs": "pm2 logs student-handbook",
    "pm2:delete": "pm2 delete student-handbook",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:duplication": "jscpd src",
    "check:deps": "knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.37",
    "@ai-sdk/react": "^4.0.95",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "ai": "^7.0.92",
    "cnfast": "^0.1.0",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.15.5",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.5",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jscpd": "^5.1.2",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.0"
}
